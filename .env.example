# Postgres ühendus. Supabase'is: Connect → Transaction pooler (port 6543), kasutaja
# app_server.<projekti-ref> (vt supabase/migrations/0002_kasutajad.sql). MITTE postgres.
# Kohalikus arenduses võib kasutada postgres kasutajat (demosisselogimine vajab seda).
# Väljapoole minev ühendus on alati TLS-iga krüpteeritud.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/arengukava

# Soovitatav tootmises: Supabase'i CA-sertifikaat (Database → SSL Configuration →
# Download certificate), PEM-sisu. Siis kontrollitakse ka andmebaasi serveri sertifikaati.
# DATABASE_CA_CERT="-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----"

# Supabase Auth (sisselogimine e-posti lingiga). Project Settings → API.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# AINULT kohalikuks demoks: sisselogimine kasutaja valikuga, ilma Supabase'ita.
# Tootmises (next start / NODE_ENV=production) on see alati väljas.
DEV_LOGIN=1

# Valikuline: simuleeritud "tänane" kuupäev (näidisandmed kirjeldavad 2027. a sügist).
ARUANDE_KUUPAEV=2027-10-01

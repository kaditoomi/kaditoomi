# Postgres ühendus. Supabase'is: Project Settings → Database → Connection string
# (Session pooler, port 5432, või Transaction pooler, port 6543).
DATABASE_URL=postgres://postgres:postgres@localhost:5432/arengukava

# Supabase Auth (sisselogimine e-posti lingiga). Project Settings → API.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# AINULT kohalikuks demoks: sisselogimine kasutaja valikuga, ilma Supabase'ita.
# Tootmises (next start / NODE_ENV=production) on see alati väljas.
DEV_LOGIN=1

# Valikuline: simuleeritud "tänane" kuupäev (näidisandmed kirjeldavad 2027. a sügist).
ARUANDE_KUUPAEV=2027-10-01
